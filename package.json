    "md5": "^2.3.0",
    "moment": "^2.30.1",
    "node-fetch": "^3.3.2",
    "node-schedule": "^2.1.1",
    "oicq": "^2.3.1",
    "pm2": "^7.0.4",
    "puppeteer": "*",
